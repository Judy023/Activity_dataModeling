{{> head }}
<form action="/update/{{ data.id }}" method="Post">
    <input type="hidden" name="id" placeholder="id" value="{{data.id}}">
    <label for="Name">Name</label>
    <input type="text" name="Name" placeholder="Name" value="{{data.Name}}">
    <label for="Description">Description</label>
    <input type="text" name="Description" placeholder="Description" value="{{data.Description}}">
    <label for="Quantity">Quantity</label>
    <input type="text" name="Quantity" placeholder="Quantity" value="{{data.Quantity}}">
    <label for="Production">Production</label>
    <input type="text" name="Production" placeholder="Production" value="{{data.Production}}">
    <label for="Price">Price</label>
    <input type="text" name="Price" placeholder="Price" value="{{data.Price}}">
    <input type="submit" name="save">
</form>

